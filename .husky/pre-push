#!/bin/env sh
set -e

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "❌ You have uncommitted changes. Please stash or commit them before pushing." >&2
  exit 1
fi

echo "🧪 Running tests..."
(cd "$(git rev-parse --show-toplevel)" && npm test)
echo "✅ All tests passed — push allowed."
